<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the CRM API.

  Copy this file next to CrmApi.dll in your published folder.

  !! FILL IN THE TWO EMPTY VALUES ON THE SERVER, NOT IN GIT.        !!
  !! This repository is PUBLIC - a real database password or JWT     !!
  !! signing key committed here would be readable by anyone.        !!

  After editing web.config on the server, restart the application pool
  (iisreset, or recycle the pool in IIS Manager). IIS reads these values
  only at process start.
-->
<configuration>

  <system.webServer>
    <handlers>
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\CrmApi.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">

      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!-- Do NOT declare Jwt__Key / ConnectionStrings__Default /
             Cors__Origins__0 here with an empty value.

             An environment variable - even an empty one - has higher
             precedence than appsettings.Production.json. A blank entry
             silently overrides the real value and produces all of these
             symptoms at once:
               * database: "unreachable"      (empty connection string)
               * jwtKeyIsGeneratedFallback: true   (empty JWT key)
               * CORS blocks the deployed frontend (blank origin is dropped)

             Set these on the host (control-panel environment variables) or
             fill them in appsettings.Production.json. If you really must
             declare them here, use real values - never value="". -->
      </environmentVariables>

    </aspNetCore>
  </system.webServer>

</configuration>