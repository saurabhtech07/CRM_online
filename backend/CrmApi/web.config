<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the CRM API.

  Copy this file next to CrmApi.dll in your published folder.

  !! FILL IN THE TWO EMPTY VALUES ON THE SERVER, NOT IN GIT.        !!
  !! This repository is PUBLIC - a real database password or JWT     !!
  !! signing key committed here would be readable by anyone.        !!

  After editing web.config on the server, restart the application pool
  (iisreset, or recycle the pool in IIS Manager). IIS reads these values
  only at process start.
-->
<configuration>

  <system.webServer>
    <handlers>
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\CrmApi.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">

      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!-- REQUIRED, minimum 32 characters. The app refuses to start
             without it and IIS will report HTTP 500.30.
             Generate one with:  openssl rand -base64 48 -->
        <environmentVariable name="Jwt__Key" value="" />

        <!-- REQUIRED. Full SQL Server connection string. -->
        <environmentVariable name="ConnectionStrings__Default" value="" />

        <!-- REQUIRED. Exact frontend origin: scheme + host + port,
             no trailing slash. Add Cors__Origins__1, __2 ... as needed. -->
        <environmentVariable name="Cors__Origins__0" value="" />
      </environmentVariables>

    </aspNetCore>
  </system.webServer>

</configuration>