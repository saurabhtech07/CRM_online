# ---------------------------------------------------------------------------
# Backend environment variables.
# Copy to `.env.local` or, better, set these directly in your hosting
# platform's dashboard (Azure App Service, Render, Railway, IIS, systemd, ...).
# ASP.NET Core reads these automatically and they OVERRIDE appsettings*.json.
#
# .NET maps `__` (double underscore) to `:` so `Jwt__Key` == `Jwt:Key`.
#
#  !! Never commit real values. This repository is PUBLIC.               !!
# ---------------------------------------------------------------------------

# Signing key for JWTs, minimum 32 characters.
# Generate one:  openssl rand -base64 48
#
# If you leave this empty the app generates a random key on first start and
# saves it as `jwt.key` next to CrmApi.dll, reusing it afterwards. That keeps a
# single-instance deploy working with no configuration. Still set this value:
# on a load-balanced deployment each instance would otherwise generate a
# different key and cross-instance tokens would fail to validate.
Jwt__Key=

# REQUIRED. Full SQL Server connection string.
# MonsterASP example:
#   Server=sql123.monsterasp.net;Database=yourdb;User Id=youruser;Password=yourpassword;TrustServerCertificate=True;Encrypt=True;
# Local SQL Express example:
#   Server=localhost;Database=RealEstateCRM;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__Default=

# REQUIRED in production. Repeat with __1, __2 ... for extra origins.
# Must be the EXACT frontend origin (scheme + host + port), no trailing slash.
Cors__Origins__0=http://localhost:3100

# Optional. Defaults shown.
Jwt__Issuer=CrmApi
Jwt__Audience=CrmClient
Jwt__ExpiryMinutes=480

# Optional. Set to Production on the host (most platforms do this for you).
ASPNETCORE_ENVIRONMENT=Production

# Optional. Most PaaS hosts inject their own port; don't hardcode it.
# ASPNETCORE_URLS=http://0.0.0.0:5072