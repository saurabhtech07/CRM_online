# ============================================================
#  Real Estate CRM — root .gitignore
# ============================================================

# ---- SECRETS (never commit) ----
**/appsettings.Production.json
**/appsettings.Development.json
**/appsettings.*.Local.json
*.env
.env
.env.*
!.env.example

# ---- .NET backend build output ----
**/bin/
**/obj/
**/out/
*.user
.vs/

# ---- Node / Next.js frontend ----
**/node_modules/
**/.next/
**/build/
**/dist/
**/.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.swp

# ---- Claude / local tooling ----
.claude/
