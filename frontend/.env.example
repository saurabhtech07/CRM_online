# ---------------------------------------------------------------------------
# Frontend environment variables.
# Copy to `.env.local` for local dev, or set these in your hosting dashboard.
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME - changing them requires a
# rebuild, not just a restart.
# ---------------------------------------------------------------------------

# Base URL of the ASP.NET Core API.
# Local dev (leave unset or use this):
NEXT_PUBLIC_API_BASE=http://localhost:5072/api

# Production example - same domain, backend proxied under /api:
# NEXT_PUBLIC_API_BASE=https://crm.example.com/api
#
# Production example - backend on a separate subdomain:
# NEXT_PUBLIC_API_BASE=https://api.crm.example.com/api